<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.balanceeat.demo.domain.diet.mapper.DietMapper">
    <insert id="insert" parameterType="com.balanceeat.demo.domain.diet.entity.Diet">
        INSERT INTO diets (
            user_id,
            nutrition_id,
            diet_date,
            meal_type,
            meal_time,
            amount,
            note
        ) VALUES (
            #{userId},
            #{nutritionId},
            #{dietDate},
            #{mealType},
            #{mealTime},
            #{amount},
            #{note}
        )
    </insert>

    <update id="update" parameterType="com.balanceeat.demo.domain.diet.entity.Diet">
        UPDATE diets
        <set>
            <if test="amount != null">amount = #{amount},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM diets WHERE id = #{id}
    </delete>

    <resultMap id="DietResultMap" type="com.balanceeat.demo.domain.diet.entity.Diet">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="nutritionId" column="nutrition_id"/>
        <result property="dietDate" column="diet_date"/>
        <result property="foodName" column="food_name"/>
        <result property="mealType" column="meal_type" javaType="com.balanceeat.demo.domain.diet.entity.MealType"/>
        <result property="mealTime" column="meal_time"/>
        <result property="amount" column="amount"/>
        <result property="note" column="note"/>
    </resultMap>

    <select id="findByDate" resultMap="DietResultMap">
        SELECT 
            id,
            user_id,
            nutrition_id,
            diet_date,
            food_name,
            meal_type,
            meal_time,
            amount,
            note
        FROM diets
        WHERE user_id = #{userId}
        AND diet_date = #{date}
        ORDER BY meal_type, id
    </select>

    <select id="findById" resultMap="DietResultMap">
        SELECT 
            id,
            user_id,
            nutrition_id,
            diet_date,
            food_name,
            meal_type,
            meal_time,
            amount,
            note
        FROM diets
        WHERE id = #{id}
    </select>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO diets (
            user_id,
            nutrition_id,
            food_name,
            diet_date,
            meal_type,
            meal_time,
            amount,
            note
        ) VALUES 
        <foreach collection="list" item="diet" separator=",">
            (
                #{diet.userId},
                #{diet.nutritionId},
                #{diet.foodName},
                #{diet.dietDate},
                #{diet.mealType},
                #{diet.mealTime},
                #{diet.amount},
                #{diet.note}
            )
        </foreach>
    </insert>
</mapper> 