<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.balanceeat.demo.domain.chat.mapper.ChatSessionMapper">
    
    <select id="findById" resultType="com.balanceeat.demo.domain.chat.entity.ChatSession">
        SELECT * FROM chat_sessions WHERE session_id = #{sessionId}
    </select>

    <insert id="insert" parameterType="com.balanceeat.demo.domain.chat.entity.ChatSession">
        INSERT INTO chat_sessions (session_id, title, user_id, created_at, updated_at)
        VALUES (#{sessionId}, #{title}, #{userId}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update" parameterType="com.balanceeat.demo.domain.chat.entity.ChatSession">
        UPDATE chat_sessions
        SET title = #{title},
            updated_at = #{updatedAt}
        WHERE session_id = #{sessionId}
    </update>

    <delete id="delete">
        DELETE FROM chat_sessions WHERE session_id = #{sessionId}
    </delete>

</mapper> 